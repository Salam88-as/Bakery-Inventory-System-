@model BakeryInventorySystem.Models.Ingredient
@{
    ViewBag.Title = "Edit Ingredient"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel-box" style="max-width:500px;">
    <h5>Edit Ingredient</h5>
    <form method="post" action="/Ingredients/Edit">
        <input type="hidden" name="IngredientId" value="@Model.IngredientId" />
        <div class="mb-3">
            <label>Name</label>
            <input type="text" name="Name" value="@Model.Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label>Unit</label>
            <input type="text" name="Unit" value="@Model.Unit" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Current Stock</label>
            <input type="number" step="0.01" name="CurrentStock" value="@Model.CurrentStock" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Reorder Level</label>
            <input type="number" step="0.01" name="ReorderLevel" value="@Model.ReorderLevel" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Supplier</label>
            @Html.DropDownList("SupplierId", null, "-- Select Supplier --", new { @class = "form-control" })
        </div>
        <button type="submit" class="btn btn-success">Update</button>
        <a href="/Ingredients" class="btn btn-secondary">Cancel</a>
    </form>
</div>
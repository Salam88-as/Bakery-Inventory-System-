@model IEnumerable<BakeryInventorySystem.Models.Supplier>
@{
    ViewBag.Title = "Suppliers"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel-box">
    <div class="d-flex justify-content-between mb-3">
        <h5>👥 Suppliers</h5>
        <a href="/Suppliers/Create" class="btn btn-primary btn-sm">+ Add Supplier</a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr><th>Name</th><th>Contact Person</th><th>Phone</th><th>Email</th><th>Address</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ContactPerson</td>
                    <td>@item.Phone</td>
                    <td>@item.Email</td>
                    <td>@item.Address</td>
                    <td>
                        <a href="/Suppliers/Edit/@item.SupplierId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a href="/Suppliers/Delete/@item.SupplierId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this supplier?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model IEnumerable<BakeryInventorySystem.Models.Product>
@{
    ViewBag.Title = "Products"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel-box">
    <div class="d-flex justify-content-between mb-3">
        <h5>🎂 Products</h5>
        <a href="/Products/Create" class="btn btn-primary btn-sm">+ Add Product</a>
    </div>
    <table class="table table-hover">
        <thead>
            <tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Category != null ? item.Category.Name : "-")</td>
                    <td>$@item.Price.ToString("N2")</td>
                    <td>@item.StockQuantity</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>
                        <a href="/Products/Edit/@item.ProductId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a href="/Products/Delete/@item.ProductId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
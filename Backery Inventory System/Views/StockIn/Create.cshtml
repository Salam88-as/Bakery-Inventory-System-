@model BakeryInventorySystem.Models.StockIn
@{
    ViewBag.Title = "Add Stock In"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel-box" style="max-width:500px;">
    <h5>Add Stock In</h5>
    <form method="post" action="/StockIn/Create">
        <div class="mb-3">
            <label>Ingredient</label>
            @Html.DropDownList("IngredientId", null, "-- Select Ingredient --", new { @class = "form-control" })
        </div>
        <div class="mb-3"><label>Quantity</label><input type="number" step="0.01" name="Quantity" class="form-control" required /></div>
        <div class="mb-3">
            <label>Supplier</label>
            @Html.DropDownList("SupplierId", null, "-- Select Supplier --", new { @class = "form-control" })
        </div>
        <div class="mb-3"><label>Notes</label><textarea name="Notes" class="form-control"></textarea></div>
        <button type="submit" class="btn btn-success">Save</button>
        <a href="/StockIn" class="btn btn-secondary">Cancel</a>
    </form>
</div>
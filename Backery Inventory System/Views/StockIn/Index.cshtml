@model IEnumerable<BakeryInventorySystem.Models.StockIn>
@{
    ViewBag.Title = "Stock In"; Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel-box">
    <div class="d-flex justify-content-between mb-3">
        <h5>⬇ Stock In</h5>
        <a href="/StockIn/Create" class="btn btn-primary btn-sm">+ Add Stock</a>
    </div>
    <table class="table table-hover">
        <thead><tr><th>Ingredient</th><th>Quantity</th><th>Supplier</th><th>Date Received</th><th>Notes</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Ingredient != null ? item.Ingredient.Name : "-")</td>
                    <td>@item.Quantity @(item.Ingredient != null ? item.Ingredient.Unit : "")</td>
                    <td>@(item.Supplier != null ? item.Supplier.Name : "-")</td>
                    <td>@item.DateReceived.ToString("dd/MM/yyyy hh:mm tt")</td>
                    <td>@item.Notes</td>
                </tr>
            }
        </tbody>
    </table>
</div>